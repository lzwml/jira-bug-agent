# 任意支持 OpenAI Chat Completions + tool_calls 的模型服务。
BUG_AGENT_LLM_BASE_URL=https://your-llm-gateway.example/v1
BUG_AGENT_LLM_API_KEY=replace-with-your-key
BUG_AGENT_LLM_MODEL=your-model-name
# 对 429、5xx 和临时网络错误做有限指数退避，不消耗 Agent 步骤。
# BUG_AGENT_LLM_MAX_RETRIES=2
# BUG_AGENT_LLM_RETRY_BASE_SECONDS=1
# Jira 描述和完整评论的读取硬上限；小上下文直接注入，大上下文分块编译。
# BUG_AGENT_JIRA_CONTEXT_MAX_CHARS=1000000
# BUG_AGENT_JIRA_DIRECT_CONTEXT_MAX_CHARS=60000
# 直接注入阈值、Comment Compiler 每个分块与最终摘要的字符预算。
# BUG_AGENT_JIRA_CONTEXT_CHUNK_CHARS=24000
# BUG_AGENT_JIRA_CONTEXT_SUMMARY_MAX_CHARS=30000
# BUG_AGENT_JIRA_COMPILER_MAX_CHUNKS=12
# BUG_AGENT_JIRA_COMPILER_MAX_ATTEMPTS=16
# BUG_AGENT_JIRA_COMPILER_TIMEOUT_SECONDS=180
BUG_AGENT_MAX_STEPS=12
BUG_AGENT_LLM_TIMEOUT_SECONDS=120
BUG_AGENT_MAX_TOOL_RESULT_CHARS=40000
# 可选：覆盖仓库内置 skills/ 目录，适合部门集中分发 Skills。
# BUG_AGENT_SKILLS_ROOT=D:\team-bug-skills

# Jira Cloud 示例；本地 Case 模式不需要这些变量。
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_DEPLOYMENT=cloud
JIRA_AUTH_MODE=basic
JIRA_USER=you@example.com
JIRA_TOKEN=replace-with-your-jira-token
JIRA_EXPORT_ROOT=./exports
JIRA_VERIFY_SSL=true
# false 表示 Jira 请求不继承全局 HTTP_PROXY/HTTPS_PROXY，内网直连推荐保持 false。
JIRA_TRUST_ENV=false
# 安全默认值是单附件 50 MiB / 单次导出 200 MiB。大型 Android 日志可按磁盘预算提高。
# JIRA_MAX_ATTACHMENT_BYTES=2147483648
# JIRA_MAX_EXPORT_BYTES=8589934592
# 企业自定义字段必须按字段 ID 显式允许，例如车型、分支、复现概率。
# JIRA_EXTRA_FIELDS=customfield_12345,customfield_12346

# Log MCP 只读取 LOG_ANALYZER_ALLOWED_ROOTS 下的 Case；展开内容和索引写入隔离工作区。
# Windows 多个允许根目录使用分号分隔。
LOG_ANALYZER_ALLOWED_ROOTS=./exports
# LOG_ANALYZER_WORK_ROOT=D:\bug-agent-cache\log-analyzer
# AEE_EXTRACT_BIN=D:\tools\aee_extract.exe
# 以下预算只能由 Server 配置，模型的 Tool Call 无法扩大。
# LOG_ANALYZER_MAX_ARCHIVE_BYTES=4294967296
# LOG_ANALYZER_MAX_EXTRACTED_FILES=20000
# LOG_ANALYZER_MAX_MEMBER_BYTES=4294967296
# LOG_ANALYZER_MAX_EXTRACTED_BYTES=17179869184
# LOG_ANALYZER_MAX_COMPRESSION_RATIO=200
# LOG_ANALYZER_MAX_ARCHIVE_DEPTH=2
# LOG_ANALYZER_MAX_EXTRACT_SECONDS=300
# LOG_ANALYZER_MAX_INDEX_BYTES=17179869184
# LOG_ANALYZER_MAX_INDEX_STORAGE_BYTES=17179869184
# LOG_ANALYZER_INDEX_CHUNK_BYTES=1048576
# LOG_ANALYZER_MAX_INDEX_SECONDS=600
# LOG_ANALYZER_MAX_INDEX_QUERY_SECONDS=30

# OpenGrok 代码搜索（可选，默认关闭）
# OPENGROK_ENABLE_CODE_SEARCH=true
# OPENGROK_BASE_URL=https://opengrok.example.com/source/
# OPENGROK_USERNAME=your-username
# OPENGROK_PASSWORD=your-password
# OPENGROK_VERIFY_SSL=false

# 视频证据 MCP（可选，默认关闭）。启用后 Worker 只把当前 Case/导出根目录授权给该 MCP。
# VIDEO_ANALYZER_ENABLE=true
# 视频 MCP 使用 ffprobe 读取元数据、ffmpeg 提取关键帧和裁剪片段。
# VIDEO_ANALYZER_FFMPEG_BIN=ffmpeg
# VIDEO_ANALYZER_FFPROBE_BIN=ffprobe
# VIDEO_ANALYZER_MAX_VIDEO_BYTES=2147483648
# VIDEO_ANALYZER_MAX_DURATION_SECONDS=1800
# 视觉模型需兼容 OpenAI Chat Completions 的 image_url 输入；仅在调用 analyze_video/query_video 时使用。
# VIDEO_ANALYZER_PROVIDER_URL=https://your-vision-gateway.example/v1
# VIDEO_ANALYZER_PROVIDER_API_KEY=replace-with-your-key
# VIDEO_ANALYZER_PROVIDER_MODEL=your-vision-model
# 可选：把关键帧、裁剪片段置于服务端工作区，而非 Case 目录。
# VIDEO_ANALYZER_WORK_ROOT=D:\bug-agent-cache\video-analysis
